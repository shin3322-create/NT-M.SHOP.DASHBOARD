{
  "manifest_version": 3,
  "name": "NT DMS 확장팩",
  "version": "1.0.7",
  "description": "DMS NEXT의 RO 리포트·예약 현황을 AS 대시보드(SA/리셉션)에 자동 입력합니다.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.bmwdms.co.kr/*",
    "https://nt-server.tail55a6d4.ts.net/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.bmwdms.co.kr/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_idle", "all_frames": false },
    { "matches": ["https://www.bmwdms.co.kr/*"], "js": ["bridge.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "action": { "default_popup": "popup.html", "default_title": "NT DMS 확장팩" },
  "options_page": "popup.html"
}
